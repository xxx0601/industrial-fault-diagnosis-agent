# 复制为 backend/.env 后填入真实值

APP_NAME=Industrial Fault Diagnosis API
APP_ENV=development
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8001

# 允许的前端源（逗号分隔）
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# 设备日志上传
UPLOAD_DIR=uploads
UPLOAD_INDEX_PATH=data/uploads_index.json
UPLOAD_MAX_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=txt,csv,json

# 故障诊断 Agent（langgraph | mock）
AGENT_BACKEND=langgraph
DIAGNOSIS_INDEX_PATH=data/diagnosis_index.json

# RAG / 知识库
RAG_ENABLED=true
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=fault_diagnosis_knowledge
KNOWLEDGE_FILES_DIR=knowledge_files
KNOWLEDGE_INDEX_PATH=data/knowledge_index.json
RAG_DEFAULT_TOP_K=5
KNOWLEDGE_ALLOWED_EXTENSIONS=pdf,txt
# auto = try ChromaDB, fallback memory | chroma | memory
VECTOR_STORE_BACKEND=auto
MEMORY_VECTOR_INDEX_PATH=data/memory_vectors.json
WORK_ORDER_INDEX_PATH=data/work_orders_index.json

# 后续步骤使用
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/fault_diagnosis
# OPENAI_API_KEY=
# CHROMA_PERSIST_DIR=./data/chroma
